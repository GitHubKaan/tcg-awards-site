# Port the API/CDN listens on.
PORT=4000

# Password required to log into /admin. CHANGE THIS.
ADMIN_PASSWORD=change-me

# Secret used to sign session tokens (JWT). CHANGE THIS to a long random string.
JWT_SECRET=change-me-too

# Origin allowed to call the API (the frontend dev/prod URL).
CORS_ORIGIN=http://localhost:3000

# Public base URL of this backend, used to build CDN links for uploaded media.
CDN_PUBLIC_URL=http://localhost:4000
